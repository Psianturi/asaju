# MAEF Backend — Local development environment
# Copy to backend/.env for local testing (never commit the real .env)

# ── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=agentic-event-factory

# Set to false for local dev so secrets are read from env vars below
USE_SECRET_MANAGER=false

# ── Secrets (used when USE_SECRET_MANAGER=false) ─────────────────────────────
# The backend minting wallet's private key (holds MINTER_ROLE on contract)
AGENT_PRIVATE_KEY=0x_your_agent_private_key_here

# Preferred operational key for Mode A minting (separate from deployer/admin wallet)
# If set, backend uses this value instead of AGENT_PRIVATE_KEY for fallback/Mode A.
MINTER_SERVICE_PRIVATE_KEY=0x_your_minter_service_private_key_here

# Google Gemini API key — https://aistudio.google.com/app/apikey
LLM_API_KEY=your_gemini_api_key_here

# ── MiniMax (optional second LLM provider) ───────────────────────────────────
# Used for Agent Room dialogue, where a model tuned for multi-turn role play
# reads more naturally than a general model. Gemini stays the default and the
# fallback: it guarantees JSON for proposals and wisdom reports, which the rest
# of the app parses.
#
# This is the MiniMax *subscription* key (starts with sk-cp-), not a
# pay-as-you-go key. It only works against the M Plan quota — the console has to
# show your subscription as active or every call fails.
#
#   Console:  https://platform.minimax.io/console/plan
#   Base URL: https://api.minimax.io/v1          (OpenAI-compatible)
#              https://api.minimax.io/anthropic   (Anthropic-compatible)
#   Plan page: https://platform.minimax.io/docs/guides/text-generation
#
# Leave unset to run entirely on Gemini.
MINIMAX_API_KEY=
# M3.1 is multimodal and agentic; M2-her is tuned for dialogue and role play.
# Plan access differs by tier — check the "Models" tab in the console.
MINIMAX_MODEL=MiniMax-M3.1-Flash-Preview
# low | medium | high | xhigh | max. Thinking cannot be disabled on M3.1;
# lower effort to cut latency and tokens rather than trying to switch it off.
MINIMAX_EFFORT=high

# ── Blockchain ────────────────────────────────────────────────────────────────
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
CHAIN_ID=5003

# Fill in after: cd contracts && npm run deploy:sepolia
CONTRACT_ADDRESS=0x66fD8b5411856D42c08D9356e879a6e7dF0c9419

# ── Auto Scout (Secretary sub-agent) ─────────────────────────────────────────
# YouTube Data API v3 key — enable at: console.cloud.google.com → APIs → YouTube Data API v3
# Without this, POST /api/v1/agent/{id}/scout returns 503
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# CORS: comma-separated origins allowed to call the backend (default: the
# asaju.vercel.app / asaju-dev.vercel.app domains plus localhost dev ports).
# Vercel preview URLs of this project are allowed by ALLOWED_ORIGIN_REGEX.
ALLOWED_ORIGINS_RAW=http://localhost:5173,http://localhost:5174

# Chains whose new spawns go to V7 (e.g. 5003). Empty = off.
V7_SPAWN_CHAINS=
