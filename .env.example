# MAEF - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ========================================
# Blockchain Configuration (Mantle Network)
# ========================================

# Mantle Network RPC URL
# Mainnet: https://rpc.mantle.xyz  |  Sepolia Testnet: https://rpc.sepolia.mantle.xyz
VITE_MANTLE_NETWORK_URL=https://rpc.sepolia.mantle.xyz

# Chain ID: 5000 = Mainnet, 5003 = Sepolia Testnet (use 5003 for dev/staging)
VITE_CHAIN_ID=5003

# Block Explorer URL
# Mainnet: https://explorer.mantle.xyz  |  Sepolia: https://explorer.sepolia.mantle.xyz
VITE_EXPLORER_URL=https://explorer.sepolia.mantle.xyz


# ========================================
# Smart Contract Addresses
# ========================================

# NFT Contract Address — fill in after running: npm run deploy:sepolia (from /contracts/)
# Per-network overrides (recommended after deploy):
VITE_NFT_CONTRACT_ADDRESS_SEPOLIA=0x110edEa5DB874589ec4492d15660082634E173f0
VITE_NFT_CONTRACT_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000
# Fallback (used for both networks if per-network var not set):
VITE_NFT_CONTRACT_ADDRESS=0x110edEa5DB874589ec4492d15660082634E173f0

# Agent Factory Contract Address
VITE_AGENT_FACTORY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000




# VITE_GCP_BACKEND_URL=https://agentic-event-factory.run.app
VITE_GCP_BACKEND_URL=
# Dev-only override, wins over VITE_GCP_BACKEND_URL when present. Use this on
# preview branches that should point at a tagged Cloud Run revision, so the
# shared variable that Production also uses never has to be edited.
# VITE_GCP_BACKEND_URL_DEV=https://dev---mantle-agentic-event-xxxxx-asia-southeast1.run.app
VITE_GCP_BACKEND_URL_DEV=


# ========================================
# Application Settings
# ========================================

# Application Environment
VITE_ENVIRONMENT=development

# Enable Debug Mode
VITE_DEBUG_MODE=true

# Default Gas Limit for transactions
VITE_DEFAULT_GAS_LIMIT=500000

# Gas Price Multiplier (for faster transactions)
VITE_GAS_PRICE_MULTIPLIER=1.2


# ========================================
# Feature Flags
# ========================================

# Enable Blockchain Integration
VITE_ENABLE_BLOCKCHAIN=true

# Enable Agent Breeding
VITE_ENABLE_BREEDING=true

# Enable Marketplace
VITE_ENABLE_MARKETPLACE=true


# ========================================
# Analytics & Monitoring (Optional)
# ========================================

# Google Analytics ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN (for error tracking)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx


# ========================================
# Backend API (Optional - for Cloud Run)
# ========================================

# Cloud Run Backend URL
# VITE_BACKEND_API_URL=https://your-app.run.app

# API Authentication Token
# VITE_API_AUTH_TOKEN=your_secure_token


# ========================================
# Development Settings
# ========================================

# Local Development Port
# PORT=5173

# Enable Source Maps in Production
# VITE_SOURCEMAP=false

# Privy (email / Google sign-in with an embedded wallet). Leave empty to keep
# wallet-only login; the Privy bundle is not loaded without it. The App ID is
# public; the App secret is server-side only and is NOT used by the frontend.
VITE_PRIVY_APP_ID=
